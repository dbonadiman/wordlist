#! /usr/bin/env python
from __future__ import print_function

import codecs
import errno
import os
import re
import sys
import time
from argparse import ArgumentParser, RawDescriptionHelpFormatter

# Recognised backslash escapes in --delimiter (so `-d '\t'` works without
# needing the shell's $'...' quoting).  Anything else is left untouched,
# so real (including non-ASCII) characters pass through unharmed.
_ESCAPE_RE = re.compile(r"\\(?:[ntrfv0abe\\'\"]|x[0-9A-Fa-f]{2}|[0-7]{1,3})")


def __decode_escapes(text):
    return _ESCAPE_RE.sub(
        lambda m: codecs.decode(m.group(0), 'unicode_escape'), text)


def __get_parser(version):
    # command line option parsing
    parser = ArgumentParser(
        description='Generate every word over a charset, by length range '
                    'or following a pattern.',
        epilog='Examples:\n'
               '  wordlist abc -m 1 -M 3             # words of length 1..3\n'
               '  wordlist a-z0-9 -M 4 -o list.txt   # ranges, to a file\n'
               '  wordlist abc @@q@@                 # pattern (@ = any char)\n'
               '  wordlist a-z -M 6 -o out -s 4      # 4 shards out.000..003',
        formatter_class=RawDescriptionHelpFormatter)
    parser.add_argument('charset',
                        help='characters to use; supports a-z / 0-9 ranges')
    parser.add_argument('-m', '--min', type=int, metavar='N',
                        help='minimum word length (default 1)')
    parser.add_argument('-M', '--max', type=int, metavar='N',
                        help='maximum word length (default: charset length)')
    parser.add_argument('-o', '--out', metavar='FILE',
                        help='write to FILE instead of stdout')
    parser.add_argument('-d', '--delimiter', default='\n', metavar='SEP',
                        help=r"separator after each word (default '\n'); "
                             r"backslash escapes like \t \0 \r are decoded, "
                             "use '' for none")
    parser.add_argument('pattern', nargs='?',
                        help="pattern where each '@' is replaced by any "
                             "charset character (e.g. a@b@)")
    parser.add_argument('-s', '--shards', type=int, default=1, metavar='N',
                        help='split output across N files (needs -o); they '
                             'concatenate to the single-file output')
    parser.add_argument('-c', '--count', default=False, action='store_true',
                        help='print how many words (and bytes) would be '
                             'generated, then exit without generating them')
    parser.add_argument('-v', '--verbose', default=False, action='store_true',
                        help='print a summary and timing to stderr')
    parser.add_argument('--version', action='version',
                        version='wordlist ' + version)
    return parser


def __estimate(wrdlst, pattern, minlen, maxlen):
    """Return (word_count, byte_count) without enumerating anything."""
    if pattern:
        return wrdlst.count_with_pattern(pattern)
    return wrdlst.count(minlen, maxlen)


def __human(n):
    for unit in ('B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB'):
        if n < 1024.0 or unit == 'PiB':
            return '%.1f %s' % (n, unit)
        n /= 1024.0


def main():
    parser = __get_parser(wordlist.__version__)
    args = vars(parser.parse_args())

    charset = args['charset']
    pattern = args['pattern']
    minlen = args['min'] if args['min'] is not None else 1
    maxlen = args['max'] if args['max'] is not None else len(charset)
    verbose = args['verbose']
    shards = args['shards']
    delimiter = __decode_escapes(args['delimiter'])

    wrdlst = wordlist.Generator(charset, delimiter)

    if not pattern and (minlen < 1 or maxlen < minlen):
        parser.error('length range must satisfy 1 <= --min <= --max '
                     '(got min=%s, max=%s)' % (minlen, maxlen))
    if shards < 1:
        parser.error('--shards must be >= 1')

    # --count: report the size and exit without generating anything.
    if args['count']:
        words, nbytes = __estimate(wrdlst, pattern, minlen, maxlen)
        print('%d words, %d bytes (%s)' % (words, nbytes, __human(nbytes)))
        return

    if verbose:
        words, nbytes = __estimate(wrdlst, pattern, minlen, maxlen)
        if pattern:
            print('pattern: %r  (%d placeholders)'
                  % (pattern, pattern.count('@')), file=sys.stderr)
        else:
            print('lengths: %d..%d' % (minlen, maxlen), file=sys.stderr)
        print('charset: %r  (%d symbols)'
              % (wrdlst.charset, len(wrdlst.charset)), file=sys.stderr)
        print('output : %d words, %s' % (words, __human(nbytes)),
              file=sys.stderr)
    started = time.time()

    # Sharded output: split a plain (non-pattern) word list across N files
    # generated in parallel.  Needs -o for the base name.
    if shards > 1 and not pattern:
        if args['out'] is None:
            parser.error('--shards requires -o BASENAME')
        paths = ['%s.%03d' % (args['out'], i) for i in range(shards)]
        wrdlst.write_sharded(paths, minlen, maxlen)
        if verbose:
            __report(started, '%s.000..%03d' % (args['out'], shards - 1))
        return

    filedesc = None
    try:
        if args['out'] is None:
            filedesc = sys.stdout
        else:
            filedesc = open(args['out'], 'w')

        # The write* methods stream straight to the file descriptor through
        # the compiled accelerator when available (falling back to the
        # portable block generator otherwise), producing identical output.
        if pattern:
            wrdlst.write_with_pattern(filedesc, pattern)
        else:
            wrdlst.write(filedesc, minlen, maxlen)
    finally:
        if filedesc is not None and filedesc is not sys.stdout:
            filedesc.close()

    if verbose:
        __report(started, args['out'] or 'stdout')


def __report(started, where):
    print('done: %s in %.3fs' % (where, time.time() - started),
          file=sys.stderr)


def __run():
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except ValueError as err:
        print('wordlist: error: %s' % err, file=sys.stderr)
        sys.exit(1)
    except EnvironmentError as err:
        # EnvironmentError covers IOError/OSError on both Python 2 and 3.
        if getattr(err, 'errno', None) == errno.EPIPE:
            # A downstream consumer (e.g. `| head`) closed the pipe early.
            # Normal: exit quietly and silence the secondary flush error
            # Python raises at interpreter shutdown.
            try:
                devnull = os.open(os.devnull, os.O_WRONLY)
                os.dup2(devnull, sys.stdout.fileno())
            except OSError:
                pass
            sys.exit(0)
        print('wordlist: error: %s' % err, file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':

    try:
        import wordlist
    except ImportError:
        print("ERROR: The wordlist package is not properly installed",
              file=sys.stderr)
        sys.exit(1)

    __run()
